# ─── Frontend (Vercel) ───────────────────────────────────────────────────────
# Set this in Vercel → Project Settings → Environment Variables
# Replace with your actual Render backend URL after deployment
VITE_API_URL=https://frameforge-backend.onrender.com

# ─── Backend (Render) ────────────────────────────────────────────────────────
# Set this in Render → Service → Environment → Add Environment Variable
# Replace with your actual Vercel frontend URL after deployment
ALLOWED_ORIGINS=https://frameforge.vercel.app
ENVIRONMENT=production
